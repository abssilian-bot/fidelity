# Copier ce fichier en .env et remplir les valeurs
# Base PostgreSQL locale (docker) ou Supabase free tier
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fidelity?schema=public"

# Clé secrète pour signer les tokens de session / QR (générer : openssl rand -hex 32)
APP_SECRET="change-me"

# Port de l'API
PORT=3001

# Laisser vide pour garder les liens de connexion dans la réponse de développement.
RESEND_API_KEY=
EMAIL_FROM="Fidelity <onboarding@resend.dev>"
APP_URL="http://localhost:7100"

# En production : aucun lien dev n'est délivré même si la clé Resend manque.
# NODE_ENV=production
# Adresses/CIDR des reverse proxies fiables uniquement (vide = ne pas croire X-Forwarded-For).
TRUSTED_PROXIES=

# Adresses d'administrateurs approuvées par l'éditeur, séparées par des virgules.
# Le rôle est accordé après ouverture d'un lien de connexion de cette adresse.
FIDELITY_ADMIN_EMAILS=

# Apple Wallet : certificat Pass Type ID Apple et clé privée PEM, hors Git.
# APP_URL doit alors être l'URL HTTPS publique de l'application.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_WEB_SERVICE_URL=
# Exemple : https://fidelity-api-mcld.onrender.com/wallet
APPLE_WALLET_WWDR_CERT_PATH=
APPLE_WALLET_SIGNER_CERT_PATH=
APPLE_WALLET_SIGNER_KEY_PATH=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
