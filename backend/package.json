{
  "name": "fidelity-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc",
    "test:search": "node --experimental-strip-types --test scripts/test-search.mjs",
    "test:memberships": "npm run build && node --test scripts/test-memberships.mjs",
    "test:auth": "npm run build && node --test scripts/test-auth.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "build:render": "npm --prefix ../app ci --include=dev && npm --prefix ../app run build && npm run build",
    "start:render": "prisma migrate deploy && npm start",
    "test:security": "node --test scripts/test-security.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.14.0",
    "fastify": "^5.5.0",
    "resend": "^6.26.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
